---
import StyleDarkLayout from '../layouts/StyleDarkLayout.astro';
---

<StyleDarkLayout title="Style 3" description="Merc Technologies - Precision Gauge Manufacturing for Critical Tolerances">
  <!-- Hero -->
  <section class="s3-hero">
    <div class="s3-hero-media" aria-hidden="true"></div>
    <div class="s3-hero-overlay" aria-hidden="true"></div>
    <div class="container s3-hero-copy">
      <h1>Precision You Can Trust</h1>
      <p class="s3-hero-sub">
        ISO-certified gauge solutions engineered for automotive, aerospace, and manufacturing industries.
        Custom and standard gauges built to exacting specifications.
      </p>
      <div class="s3-hero-actions">
        <a class="s3-btn s3-btn-primary" href="/products">View Products</a>
        <a class="s3-btn" href="/contact">Request Quote</a>
      </div>
    </div>
    <p class="s3-hero-footnote">
      ISO 9001:2015 Certified · 20+ Years Experience · Micron-Level Precision · Custom Solutions
    </p>
    <button class="s3-hero-play" aria-label="Play">&#9654;</button>
  </section>

  <!-- What We Do -->
  <section class="s3-feature-row">
    <div class="container">
      <div class="s3-feature-grid">
        <a class="s3-feature-card" href="/products">
          <div class="s3-feature-img s3-fimg-1" aria-hidden="true"></div>
          <div class="s3-feature-bar">
            <div>
              <strong>Standard Gauges</strong>
              <p>Complete line of plug, ring, snap, and thread gauges manufactured to NABL standards.</p>
            </div>
            <i>&rarr;</i>
          </div>
        </a>
        <a class="s3-feature-card" href="/contact">
          <div class="s3-feature-img s3-fimg-2" aria-hidden="true"></div>
          <div class="s3-feature-bar">
            <div>
              <strong>Custom Gauge Design</strong>
              <p>Engineering services for special-purpose gauges designed to your exact specifications and tolerances.</p>
            </div>
            <i>&rarr;</i>
          </div>
        </a>
        <a class="s3-feature-card" href="/products">
          <div class="s3-feature-img s3-fimg-3" aria-hidden="true"></div>
          <div class="s3-feature-bar">
            <div>
              <strong>Calibration Services</strong>
              <p>NABL-traceable calibration and certification for all gauge types with fast turnaround.</p>
            </div>
            <i>&rarr;</i>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Product Overview -->
  <section class="s3-models">
    <div class="container">
      <h2 class="s3-section-title">Product Overview</h2>
      <div class="s3-model-grid">
        <article class="s3-model-card">
          <div class="s3-model-body">
            <div class="s3-model-name">Plain Gauges</div>
            <div class="s3-model-shape s3-shape-one" aria-hidden="true"></div>
          </div>
        </article>
        <article class="s3-model-card">
          <div class="s3-model-body">
            <div class="s3-model-name">Thread Gauges</div>
            <div class="s3-model-shape s3-shape-three" aria-hidden="true"></div>
          </div>
        </article>
        <article class="s3-model-card">
          <div class="s3-model-body">
            <div class="s3-model-name">Carbide Gauges</div>
            <div class="s3-model-shape s3-shape-four" aria-hidden="true"></div>
          </div>
        </article>
        <article class="s3-model-card">
          <div class="s3-model-body">
            <div class="s3-model-name">Ring Gauges</div>
            <div class="s3-model-shape s3-shape-two" aria-hidden="true"></div>
          </div>
        </article>
        <article class="s3-model-card">
          <div class="s3-model-body">
            <div class="s3-model-name">Special Gauges</div>
            <div class="s3-model-shape s3-shape-five" aria-hidden="true"></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Industries We Serve -->
  <section class="s3-industries">
    <div class="container">
      <h2 class="s3-section-title">Industries We Serve</h2>
      <div class="s3-industry-grid">
        <a class="s3-industry-card" href="/about">
          <div class="s3-industry-img s3-iimg-1" aria-hidden="true"></div>
          <span class="s3-industry-label">Automotive Manufacturing <i>&rarr;</i></span>
        </a>
        <a class="s3-industry-card" href="/about">
          <div class="s3-industry-img s3-iimg-2" aria-hidden="true"></div>
          <span class="s3-industry-label">Aerospace &amp; Defense <i>&rarr;</i></span>
        </a>
        <a class="s3-industry-card" href="/about">
          <div class="s3-industry-img s3-iimg-3" aria-hidden="true"></div>
          <span class="s3-industry-label">Medical Device Manufacturing <i>&rarr;</i></span>
        </a>
        <a class="s3-industry-card" href="/about">
          <div class="s3-industry-img s3-iimg-1" aria-hidden="true"></div>
          <span class="s3-industry-label">Oil &amp; Gas Equipment <i>&rarr;</i></span>
        </a>
        <a class="s3-industry-card" href="/about">
          <div class="s3-industry-img s3-iimg-2" aria-hidden="true"></div>
          <span class="s3-industry-label">Precision Machining <i>&rarr;</i></span>
        </a>
        <a class="s3-industry-card" href="/about">
          <div class="s3-industry-img s3-iimg-3" aria-hidden="true"></div>
          <span class="s3-industry-label">Tool &amp; Die <i>&rarr;</i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Custom Solutions -->
  <section class="s3-custom">
    <div class="container s3-custom-grid">
      <div class="s3-custom-media" aria-hidden="true"></div>
      <div class="s3-custom-text">
        <h2>Custom Gauge Solutions</h2>
        <p>
          When standard gauges don't meet your requirements, our engineering team designs and manufactures custom solutions.
          From concept to delivery, we work with your specifications to ensure perfect fit and function.
        </p>
        <ul class="s3-custom-list">
          <li>In-house engineering and design</li>
          <li>Reverse engineering capabilities</li>
          <li>Prototype development</li>
          <li>Production runs of any quantity</li>
          <li>Full documentation and certification</li>
        </ul>
        <a class="s3-btn s3-btn-primary" href="/contact">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <!-- Why Merc Technologies -->
  <section class="s3-specs">
    <div class="container">
      <h2 class="s3-section-title">Why Merc Technologies</h2>
      <div class="s3-spec-grid">
        <div>
          <strong>01</strong>
          <h3>Precision Manufacturing</h3>
          <p>State-of-the-art CNC grinding and lapping equipment ensures micron-level accuracy on every gauge.</p>
        </div>
        <div>
          <strong>02</strong>
          <h3>Quality Assurance</h3>
          <p>ISO 9001:2015 certified processes with 100% inspection and full traceability documentation.</p>
        </div>
        <div>
          <strong>03</strong>
          <h3>Fast Turnaround</h3>
          <p>Standard gauges ship in 5-7 days. Custom gauges typically delivered in 3-4 weeks.</p>
        </div>
        <div>
          <strong>04</strong>
          <h3>Technical Support</h3>
          <p>Expert application engineers available to help select the right gauge for your needs.</p>
        </div>
        <div>
          <strong>05</strong>
          <h3>Material Options</h3>
          <p>Gauge steel, carbide, chrome plated, and specialized materials for demanding applications.</p>
        </div>
        <div>
          <strong>06</strong>
          <h3>Competitive Pricing</h3>
          <p>Direct manufacturer pricing with volume discounts available for production quantities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="s3-cta">
    <div class="container s3-cta-content">
      <h2>Ready to Improve Your Quality Process?</h2>
      <p>
        Contact our engineering team to discuss your gauge requirements.
        We'll help you select or design the perfect solution.
      </p>
      <div class="s3-hero-actions">
        <a class="s3-btn s3-btn-primary" href="/contact">Request Quote</a>
        <a class="s3-btn" href="/products">Browse Products</a>
      </div>
    </div>
  </section>
</StyleDarkLayout>

<style>
  :global(body) {
    background: #fff;
    color: #0e0f12;
  }

  /* ---------- Buttons ---------- */
  .s3-btn {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 11px 24px;
    border: 1px solid currentColor;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .s3-btn-primary {
    background: #d5001c;
    border-color: #d5001c;
    color: #fff;
  }

  .s3-btn-primary:hover {
    background: #b00018;
  }

  /* ---------- Hero ---------- */
  .s3-hero {
    position: relative;
    min-height: clamp(440px, 58vw, 640px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }

  .s3-hero-media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 70% 20%, rgba(120,130,140,0.55), transparent 55%),
      linear-gradient(115deg, #3a4048 0%, #1d2025 45%, #0a0b0d 100%);
  }

  .s3-hero-media::after {
    content: "";
    position: absolute;
    right: 6%;
    top: 32%;
    width: min(58vw, 760px);
    height: 150px;
    border-radius: 999px;
    background: linear-gradient(90deg, #eef0ef, #9aa0a4 46%, #20242a);
    transform: rotate(-7deg);
    box-shadow: 0 50px 90px rgba(0,0,0,0.45);
  }

  .s3-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8,9,11,0.82) 0%, rgba(8,9,11,0.4) 48%, transparent 80%);
  }

  .s3-hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .s3-hero h1 {
    color: #fff;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.04;
    margin-bottom: 20px;
    max-width: 640px;
  }

  .s3-hero-sub {
    color: #e4e4dd;
    max-width: 520px;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .s3-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .s3-hero-footnote {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    z-index: 1;
    text-align: center;
    color: rgba(255,255,255,0.66);
    font-size: 12px;
    padding: 0 60px;
  }

  .s3-hero-play {
    position: absolute;
    right: 26px;
    bottom: 30px;
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.6);
    background: rgba(0,0,0,0.25);
    color: #fff;
    font-size: 13px;
    cursor: pointer;
  }

  /* ---------- What We Do (feature row) ---------- */
  .s3-feature-row {
    background: #fff;
    padding: 44px 0 20px;
  }

  .s3-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .s3-feature-card {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    background: #111216;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .s3-feature-img {
    height: 170px;
  }

  .s3-fimg-1 { background: linear-gradient(135deg, #6f7479, #14161a); }
  .s3-fimg-2 { background: linear-gradient(135deg, #8aa0c4, #1c2733); }
  .s3-fimg-3 { background: linear-gradient(135deg, #d5001c, #2a0e12); }

  .s3-feature-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px 22px;
    color: #fff;
  }

  .s3-feature-bar strong {
    display: block;
    font-size: 17px;
    margin-bottom: 6px;
  }

  .s3-feature-bar p {
    color: #b9bbc0;
    font-size: 13px;
    line-height: 1.5;
  }

  .s3-feature-bar i {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.5);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-style: normal;
    font-size: 13px;
  }

  /* ---------- Product Overview (model grid) ---------- */
  .s3-models {
    background: #fff;
    padding: 60px 0 80px;
  }

  .s3-section-title {
    font-size: clamp(28px, 3.6vw, 42px);
    margin-bottom: 36px;
  }

  .s3-model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px;
  }

  .s3-model-body {
    position: relative;
    background: #0e0f12;
    border-radius: 8px;
    min-height: 280px;
    padding: 26px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .s3-model-name {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    text-align: center;
    color: #fff;
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .s3-model-shape {
    width: 66%;
    height: 110px;
    border-radius: 999px;
    background: linear-gradient(90deg, #f0f0eb, #9da1a4, #25282d);
    box-shadow: 0 22px 50px rgba(0,0,0,0.5);
  }

  .s3-shape-two { border-radius: 50%; width: 150px; height: 150px;
    background: radial-gradient(circle at 50% 50%, #0e0f12 30%, #b9bdc0 31%, #e9e9e4 70%, #6b6f73 100%); }
  .s3-shape-three { border-radius: 30px;
    background: repeating-linear-gradient(90deg, #1c1f25 0 16px, #b9bdc0 16px 28px); }
  .s3-shape-four { border-radius: 14px 80px 14px 80px;
    background: linear-gradient(135deg, #cfd1d2, #6b6f73 50%, #15171c); }
  .s3-shape-five { border-radius: 80px 14px 80px 14px;
    background: linear-gradient(135deg, #d5001c, #d7d7d2 48%, #15171c); }

  /* ---------- Industries (image cards) ---------- */
  .s3-industries {
    background: #f7f7f4;
    padding: 70px 0 80px;
  }

  .s3-industry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .s3-industry-card {
    position: relative;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    min-height: 220px;
    text-decoration: none;
  }

  .s3-industry-img {
    position: absolute;
    inset: 0;
  }

  .s3-iimg-1 { background: linear-gradient(135deg, #4d5056, #14161a); }
  .s3-iimg-2 { background: linear-gradient(135deg, #7d828a, #20242b); }
  .s3-iimg-3 { background: linear-gradient(135deg, #b6453f, #2a1416); }

  .s3-industry-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(0,0,0,0.72));
  }

  .s3-industry-label {
    position: absolute;
    z-index: 1;
    left: 20px;
    right: 20px;
    bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }

  .s3-industry-label i {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.7);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-style: normal;
    font-size: 12px;
  }

  /* ---------- Custom Solutions ---------- */
  .s3-custom {
    background: #15171c;
    padding: 0;
  }

  .s3-custom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }

  .s3-custom-media {
    min-height: 480px;
    background:
      linear-gradient(180deg, transparent 10%, rgba(0,0,0,0.7)),
      radial-gradient(circle at 60% 40%, rgba(213,0,28,0.4), transparent 30%),
      linear-gradient(135deg, #4d5056, #14161a);
  }

  .s3-custom-text {
    padding: 70px clamp(20px, 4vw, 56px);
    color: #f7f7f4;
    align-self: center;
  }

  .s3-custom-text h2 {
    color: #fff;
    font-size: clamp(26px, 3.2vw, 40px);
    margin-bottom: 18px;
  }

  .s3-custom-text p {
    color: #c9c9c3;
    max-width: 520px;
    margin-bottom: 22px;
  }

  .s3-custom-list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: grid;
    gap: 12px;
    max-width: 480px;
  }

  .s3-custom-list li {
    border-top: 1px solid rgba(255,255,255,0.16);
    padding-top: 12px;
    font-weight: 600;
  }

  /* ---------- Why Merc (spec grid) ---------- */
  .s3-specs {
    background: #0e0f12;
    color: #f7f7f4;
    padding: 80px 0;
  }

  .s3-specs .s3-section-title {
    color: #fff;
  }

  .s3-spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .s3-spec-grid > div {
    border-top: 1px solid rgba(255,255,255,0.18);
    padding-top: 22px;
  }

  .s3-spec-grid strong {
    color: #d5001c;
    display: block;
    margin-bottom: 14px;
    font-size: 15px;
  }

  .s3-spec-grid h3 {
    color: #fff;
    margin-bottom: 10px;
  }

  .s3-spec-grid p {
    color: #c9c9c3;
  }

  /* ---------- Final CTA ---------- */
  .s3-cta {
    background: #15171c;
    color: #fff;
    padding: 90px 0;
  }

  .s3-cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .s3-cta-content h2 {
    color: #fff;
    font-size: clamp(26px, 3.4vw, 42px);
    margin-bottom: 18px;
  }

  .s3-cta-content p {
    color: #c9c9c3;
    margin-bottom: 30px;
  }

  .s3-cta-content .s3-hero-actions {
    justify-content: center;
  }

  .s3-cta .s3-btn:not(.s3-btn-primary) {
    color: #fff;
  }

  @media (max-width: 960px) {
    .s3-feature-grid,
    .s3-industry-grid {
      grid-template-columns: 1fr 1fr;
    }

    .s3-spec-grid {
      grid-template-columns: 1fr 1fr;
    }

    .s3-custom-grid {
      grid-template-columns: 1fr;
    }

    .s3-custom-media {
      min-height: 280px;
    }
  }

  @media (max-width: 640px) {
    .s3-feature-grid,
    .s3-model-grid,
    .s3-industry-grid,
    .s3-spec-grid {
      grid-template-columns: 1fr;
    }

    .s3-hero-footnote {
      display: none;
    }

    .s3-hero-actions {
      flex-direction: column;
    }
  }
</style>
