---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="About" description="Learn about Merc Technologies - precision gauge manufacturing excellence">
  <!-- Company Story -->
  <Section>
    <div class="about-hero">
      <h1>About Merc Technologies</h1>
      <p class="lead">
        Since 2003, we've been manufacturing precision gauges for demanding industries.
        Built on a foundation of technical expertise and unwavering commitment to quality.
      </p>
    </div>
  </Section>

  <!-- Company Story Detailed -->
  <Section>
    <div class="story-content">
      <div class="story-image">
        <div class="image-placeholder image-placeholder-4-3"></div>
      </div>
      <div class="story-text">
        <h2>Our Story</h2>
        <p>
          Merc Technologies was founded in 2003 by a team of precision manufacturing veterans who
          recognized a critical gap in the gauge industry: the need for a manufacturer that could
          deliver both standard and highly customized gauges with the same level of precision and service.
        </p>
        <p>
          Our growth has been driven by word-of-mouth recommendations from satisfied customers who
          appreciate our technical expertise, quick turnaround, and unwavering attention to detail.
        </p>
      </div>
    </div>
  </Section>

  <!-- Facility & Capability -->
  <Section className="facility-section">
    <h2 class="text-center mb-lg">Facility & Capabilities</h2>
    <div class="grid grid-2">
      <div class="facility-image">
        <div class="image-placeholder image-placeholder-16-9 mb-md"></div>
        <div class="image-placeholder image-placeholder-16-9"></div>
      </div>
      <div class="facility-details">
        <h3>Manufacturing Excellence</h3>
        <ul class="capability-list">
          <li>
            <strong>Standard and custom gauges</strong>
            <p>Plain plug, plain ring, snap, thread, carbide, and special gauges manufactured for customer component requirements.</p>
          </li>
          <li>
            <strong>Catalog-backed product ranges</strong>
            <p>Gauge types and ranges are aligned with the company's catalog wherever published ranges are available.</p>
          </li>
          <li>
            <strong>NABL-focused quality support</strong>
            <p>Calibration and certification language is aligned with NABL requirements for customer documentation.</p>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- Philosophy -->
  <Section className="philosophy-section">
    <div class="philosophy-content">
      <h2 class="text-center mb-lg">Our Philosophy</h2>
      <div class="philosophy-grid">
        <div class="philosophy-card card">
          <h3>Precision First</h3>
          <p>
            Quality is never compromised. Every gauge is manufactured to exacting standards and
            inspected before it leaves our facility.
          </p>
        </div>
        <div class="philosophy-card card">
          <h3>Customer Partnership</h3>
          <p>
            We view ourselves as an extension of your quality team. When you have a challenging
            application, our team works with you to develop the optimal solution.
          </p>
        </div>
        <div class="philosophy-card card">
          <h3>Continuous Improvement</h3>
          <p>
            The gauge industry evolves, and so do we. We continuously refine our processes to
            deliver reliable products and practical support.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Vision -->
  <Section>
    <div class="vision-content">
      <h2 class="text-center mb-lg">Our Vision</h2>
      <p class="text-center mb-xl" style="max-width: 800px; margin-left: auto; margin-right: auto;">
        We're building Merc Technologies to be the gauge manufacturer that quality professionals
        turn to first, whether they need a simple plug gauge or a special solution for a unique application.
      </p>
      <div class="grid grid-3">
        <div class="vision-item card">
          <h4>Technical Leadership</h4>
          <p>
            Continuing to push what is possible in gauge manufacturing through practical expertise
            and careful execution.
          </p>
        </div>
        <div class="vision-item card">
          <h4>Industry Support</h4>
          <p>
            Sharing our expertise through application guidance and one-on-one consultation for
            manufacturing teams.
          </p>
        </div>
        <div class="vision-item card">
          <h4>Sustainable Growth</h4>
          <p>
            Expanding our capabilities and capacity while maintaining the attention to detail
            and customer service that built our reputation.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Certifications -->
  <Section className="certifications-section">
    <h2 class="text-center mb-lg">Certifications & Standards</h2>
    <div class="certifications-grid">
      <div class="cert-item">
        <div class="cert-icon image-placeholder image-placeholder-1-1"></div>
        <h4>ISO 9001:2015</h4>
        <p>Certified quality management system</p>
      </div>
      <div class="cert-item">
        <div class="cert-icon image-placeholder image-placeholder-1-1"></div>
        <h4>NABL</h4>
        <p>Calibration and certification support</p>
      </div>
      <div class="cert-item">
        <div class="cert-icon image-placeholder image-placeholder-1-1"></div>
        <h4>Standard Gauges</h4>
        <p>Plug, ring, snap, and thread gauges</p>
      </div>
      <div class="cert-item">
        <div class="cert-icon image-placeholder image-placeholder-1-1"></div>
        <h4>Special Gauges</h4>
        <p>Manufactured for customer components</p>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section className="about-cta">
    <div class="cta-box">
      <h2>Work With Us</h2>
      <p class="mb-lg">
        Ready to experience the Merc Technologies difference? Contact our team to discuss
        your gauge requirements or schedule a facility tour.
      </p>
      <div class="cta-buttons">
        <Button href="/contact" large>Get in Touch</Button>
        <Button href="/products" large>View Products</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .about-hero {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .lead {
    font-size: 20px;
    line-height: 1.8;
    margin-bottom: 0;
  }

  .story-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    align-items: start;
  }

  .story-text p {
    margin-bottom: var(--space-md);
  }

  .facility-section {
    border-top: var(--border-thick);
    border-bottom: var(--border-thick);
  }

  .capability-list {
    list-style: none;
    padding: 0;
  }

  .capability-list li {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-thin);
  }

  .capability-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .capability-list strong {
    display: block;
    font-size: 18px;
    margin-bottom: var(--space-xs);
  }

  .capability-list p {
    margin-bottom: 0;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .philosophy-card h3 {
    margin-bottom: var(--space-md);
  }

  .philosophy-card p {
    margin-bottom: 0;
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
  }

  .cert-item {
    text-align: center;
    padding: var(--space-lg);
    border: var(--border-thin);
  }

  .cert-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--space-md);
  }

  .cert-item h4 {
    margin-bottom: var(--space-xs);
  }

  .cert-item p {
    margin-bottom: 0;
    font-size: var(--font-size-small);
  }

  .cta-box {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-2xl);
    border: var(--border-thick);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .cta-buttons {
      flex-direction: column;
    }
  }
</style>
