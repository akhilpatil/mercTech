---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProductSection from '../components/ProductSection.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Products" description="Complete line of precision gauges - standard and custom solutions for dimensional inspection">
  <!-- Introduction -->
  <Section>
    <div class="products-intro">
      <h1>Precision Gauge Products</h1>
      <p class="lead">
        From standard plug gauges to highly specialized custom solutions, Merc Technologies
        manufactures precision gauges for dimensional inspection across all industries.
        Every gauge is manufactured to exacting tolerances and 100% inspected.
      </p>
    </div>
  </Section>

  <!-- Products Content -->
  <Section>
    <!-- Standard Gauges -->
    <ProductSection title="Standard Plain Gauges">
      <p class="mb-md">
        Our standard plain gauge line covers the most common dimensional inspection needs.
        Available in catalog-backed plain plug, plain ring, and snap gauge configurations.
      </p>
      <div class="product-grid">
        <div class="product-card card">
          <div class="image-placeholder image-placeholder-4-3 mb-md"></div>
          <h4>Plain Plug Gauges</h4>
          <ul class="product-specs">
            <li>Reversible: 1mm - 8mm</li>
            <li>Taper Shank design: 2mm - 40mm</li>
            <li>Trilock design: Above 40mm</li>
          </ul>
        </div>
        <div class="product-card card">
          <div class="image-placeholder image-placeholder-4-3 mb-md"></div>
          <h4>Plain Ring Gauges</h4>
          <ul class="product-specs">
            <li>Go and No Go Ring Gauges</li>
            <li>Master Setting Rings</li>
            <li>Range: 3mm - 150mm</li>
          </ul>
        </div>
        <div class="product-card card">
          <div class="image-placeholder image-placeholder-4-3 mb-md"></div>
          <h4>Snap Gauges</h4>
          <ul class="product-specs">
            <li>Single ended: 3mm - 50mm</li>
            <li>Double ended: 3mm - 50mm</li>
            <li>Width Gauge</li>
          </ul>
        </div>
      </div>
    </ProductSection>

    <!-- Thread Gauges -->
    <ProductSection title="Thread Gauges">
      <p class="mb-md">
        Thread plug and thread ring gauges for production inspection requirements.
      </p>
      <div class="product-grid">
        <div class="product-card card">
          <div class="image-placeholder image-placeholder-1-1 mb-md"></div>
          <h4>Thread Plug Gauges</h4>
          <p>Precision ground thread gauges for internal thread inspection.</p>
        </div>
        <div class="product-card card">
          <div class="image-placeholder image-placeholder-1-1 mb-md"></div>
          <h4>Thread Ring Gauges</h4>
          <ul class="product-specs">
            <li>Metric, British and Unified</li>
            <li>Range: 5mm - 100mm</li>
          </ul>
        </div>
      </div>
    </ProductSection>

    <!-- Carbide Gauges -->
    <ProductSection title="Carbide Gauges">
      <p class="mb-md">
        Carbide plug, ring, and snap gauges available in catalog-backed types and ranges.
      </p>
      <div class="size-ranges">
        <h4>Available Configurations</h4>
        <div class="grid grid-3">
          <div class="range-item card">
            <h5>Carbide Plug Gauges</h5>
            <ul class="product-specs">
              <li>Reversible: 1mm - 8mm</li>
              <li>Taper Lock Design: 8mm - 40mm</li>
            </ul>
          </div>
          <div class="range-item card">
            <h5>Carbide Ring Gauges</h5>
            <p>Range: 3mm - 40mm</p>
          </div>
          <div class="range-item card">
            <h5>Carbide Snap Gauges</h5>
            <ul class="product-specs">
              <li>Single ended: 3mm - 50mm</li>
              <li>Double ended: 3mm - 50mm</li>
              <li>Width Gauge</li>
            </ul>
          </div>
        </div>
      </div>
    </ProductSection>

    <!-- Special Gauges -->
    <ProductSection title="Special Purpose Gauges">
      <p class="mb-md">
        Special gauges manufactured as per customer component requirements.
      </p>
      <div class="special-gauges-grid">
        <div class="special-item">
          <h4>Special Plug Gauges</h4>
        </div>
        <div class="special-item">
          <h4>Taper Gauges</h4>
        </div>
        <div class="special-item">
          <h4>Concentric Gauges</h4>
        </div>
        <div class="special-item">
          <h4>Deep bore checking Gauges</h4>
        </div>
        <div class="special-item">
          <h4>Thread depth gauge</h4>
        </div>
        <div class="special-item">
          <h4>Thread squareness checking gauge</h4>
        </div>
        <div class="special-item">
          <h4>Thread runout gauge</h4>
        </div>
        <div class="special-item">
          <h4>Concentricity gauge</h4>
        </div>
        <div class="special-item">
          <h4>Flush pin gauge</h4>
        </div>
      </div>
    </ProductSection>
  </Section>

  <!-- Final CTA -->
  <Section className="products-cta">
    <div class="cta-box">
      <h2>Need Help Selecting the Right Gauge?</h2>
      <p class="mb-lg">
        Our application engineers are available to help you choose the optimal gauge solution
        for your specific requirements. Contact us for technical assistance or a quote.
      </p>
      <div class="cta-buttons">
        <Button href="/contact" large>Request Quote</Button>
        <Button href="/about" large>Learn More About Us</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .products-intro {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .lead {
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .product-card h4 {
    margin-bottom: var(--space-sm);
  }

  .product-specs {
    margin: 0;
    padding-left: var(--space-md);
  }

  .product-specs li {
    margin-bottom: var(--space-xs);
  }

  .size-ranges h4 {
    margin-bottom: var(--space-md);
  }

  .range-item h5 {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-sm);
  }

  .range-item p {
    margin-bottom: 0;
  }

  .special-gauges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }

  .special-item {
    padding: var(--space-lg);
    border: var(--border-thin);
  }

  .special-item h4 {
    margin-bottom: 0;
  }

  .cta-box {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-2xl);
    border: var(--border-thick);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .cta-buttons {
      flex-direction: column;
    }
  }
</style>
