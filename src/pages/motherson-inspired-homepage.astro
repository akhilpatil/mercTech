---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Motherson Inspired Homepage"
  description="Merc Technologies homepage reimagined in the Motherson global manufacturing style"
>
  <!-- Announcement / utility band -->
  <div class="mi-announce">
    <div class="container mi-announce-inner">
      <span>↗ Precision Gauge Manufacturing &mdash; Since 2003</span>
      <a href="/contact">Request a quote ↗</a>
    </div>
  </div>

  <!-- Hero -->
  <section class="mi-hero">
    <div class="mi-hero-media" aria-hidden="true"></div>
    <div class="container mi-hero-inner">
      <p class="mi-eyebrow">Merc Technologies</p>
      <h1>Proud to deliver precision the world measures by.</h1>
      <p class="mi-hero-sub">
        Standard and custom gauges built for production teams who depend on repeatable accuracy,
        practical engineering support, and dependable delivery.
      </p>
    </div>
  </section>

  <!-- Intro statement -->
  <section class="mi-section mi-intro">
    <div class="container mi-intro-grid">
      <h2>
        A precision gauge design, manufacturing, calibration, and inspection specialist.
      </h2>
      <div class="mi-intro-body">
        <p>
          Merc Technologies delivers complete gauging solutions across a wide range of industries,
          leveraging expertise in design, manufacturing, and quality assurance to set benchmarks in
          accuracy and reliability.
        </p>
        <p>
          Recognised by manufacturing teams that demand critical tolerances, we continue to build
          measurement tools that keep production moving with confidence.
        </p>
        <a class="mi-btn mi-btn-red" href="/about">About us ↗</a>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="mi-section mi-light">
    <div class="container">
      <p class="mi-eyebrow mi-eyebrow-red">What we do</p>
      <h2 class="mi-section-title">Solutions for high-volume and special-purpose inspection.</h2>
      <div class="mi-card-grid">
        <article class="mi-card">
          <h3>Standard Gauges</h3>
          <p>Complete line of plug, ring, snap, and thread gauges manufactured to NABL standards.</p>
          <span class="mi-card-link">Learn more ↗</span>
        </article>
        <article class="mi-card">
          <h3>Custom Gauge Design</h3>
          <p>Engineering services for special-purpose gauges designed to your exact specifications and tolerances.</p>
          <span class="mi-card-link">Learn more ↗</span>
        </article>
        <article class="mi-card">
          <h3>Calibration Services</h3>
          <p>NABL-traceable calibration and certification for all gauge types with fast turnaround.</p>
          <span class="mi-card-link">Learn more ↗</span>
        </article>
      </div>
    </div>
  </section>

  <!-- Industries We Serve -->
  <section class="mi-section">
    <div class="container">
      <p class="mi-eyebrow mi-eyebrow-red">Industries we serve</p>
      <h2 class="mi-section-title">Built for the manufacturing chain.</h2>
      <div class="mi-industries">
        <article class="mi-industry"><div class="mi-thumb"></div><h4>Automotive Manufacturing</h4></article>
        <article class="mi-industry"><div class="mi-thumb"></div><h4>Aerospace &amp; Defense</h4></article>
        <article class="mi-industry"><div class="mi-thumb"></div><h4>Medical Device Manufacturing</h4></article>
        <article class="mi-industry"><div class="mi-thumb"></div><h4>Oil &amp; Gas Equipment</h4></article>
        <article class="mi-industry"><div class="mi-thumb"></div><h4>Precision Machining</h4></article>
        <article class="mi-industry"><div class="mi-thumb"></div><h4>Tool &amp; Die</h4></article>
      </div>
    </div>
  </section>

  <!-- Product Overview -->
  <section class="mi-section mi-light">
    <div class="container">
      <p class="mi-eyebrow mi-eyebrow-red">Product overview</p>
      <h2 class="mi-section-title">A full range of gauging products.</h2>
      <div class="mi-products">
        <article class="mi-product"><div class="mi-thumb"></div><h4>Plain Gauges</h4></article>
        <article class="mi-product"><div class="mi-thumb"></div><h4>Thread Gauges</h4></article>
        <article class="mi-product"><div class="mi-thumb"></div><h4>Carbide Gauges</h4></article>
        <article class="mi-product"><div class="mi-thumb"></div><h4>Ring Gauges</h4></article>
        <article class="mi-product"><div class="mi-thumb"></div><h4>Special Gauges</h4></article>
      </div>
    </div>
  </section>

  <!-- Custom Solutions feature -->
  <section class="mi-feature">
    <div class="container mi-feature-grid">
      <div class="mi-feature-media" aria-hidden="true"></div>
      <div class="mi-feature-copy">
        <p class="mi-eyebrow mi-eyebrow-red">Custom solutions</p>
        <h2>Custom gauge solutions, from concept to delivery.</h2>
        <p>
          When standard gauges don't meet your requirements, our engineering team designs and
          manufactures custom solutions. We work to your specifications to ensure perfect fit and function.
        </p>
        <ul class="mi-feature-list">
          <li>In-house engineering and design</li>
          <li>Reverse engineering capabilities</li>
          <li>Prototype development</li>
          <li>Production runs of any quantity</li>
          <li>Full documentation and certification</li>
        </ul>
        <a class="mi-btn mi-btn-red" href="/contact">Discuss your project ↗</a>
      </div>
    </div>
  </section>

  <!-- Why Merc -->
  <section class="mi-section">
    <div class="container">
      <p class="mi-eyebrow mi-eyebrow-red">Why Merc Technologies</p>
      <h2 class="mi-section-title">Ordinary tolerances, extraordinary precision.</h2>
      <div class="mi-why-grid">
        <div class="mi-why">
          <h4>Precision Manufacturing</h4>
          <p>State-of-the-art CNC grinding and lapping equipment ensures micron-level accuracy on every gauge.</p>
        </div>
        <div class="mi-why">
          <h4>Quality Assurance</h4>
          <p>ISO 9001:2015 certified processes with 100% inspection and full traceability documentation.</p>
        </div>
        <div class="mi-why">
          <h4>Fast Turnaround</h4>
          <p>Standard gauges ship in 5-7 days. Custom gauges typically delivered in 3-4 weeks.</p>
        </div>
        <div class="mi-why">
          <h4>Technical Support</h4>
          <p>Expert application engineers available to help select the right gauge for your needs.</p>
        </div>
        <div class="mi-why">
          <h4>Material Options</h4>
          <p>Gauge steel, carbide, chrome plated, and specialized materials for demanding applications.</p>
        </div>
        <div class="mi-why">
          <h4>Competitive Pricing</h4>
          <p>Direct manufacturer pricing with volume discounts available for production quantities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Address / directory strip -->
  <section class="mi-section mi-light">
    <div class="container mi-strip">
      <div>
        <strong>Looking for a specific Merc Technologies contact?</strong>
        <span>Reach our engineering team directly.</span>
      </div>
      <a class="mi-strip-link" href="/contact" aria-label="Go to contact">↗</a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="mi-cta">
    <div class="container mi-cta-inner">
      <h2>Ready to improve your quality process?</h2>
      <p>
        Contact our engineering team to discuss your gauge requirements. We'll help you select or
        design the perfect solution.
      </p>
      <div class="mi-cta-actions">
        <a class="mi-btn mi-btn-red" href="/contact">Request quote ↗</a>
        <a class="mi-btn mi-btn-ghost" href="/products">Browse products ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Motherson-inspired theme ===== */
  :global(body) {
    background: #ffffff;
    color: #1a1a1a;
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  /* Navigation restyle */
  :global(.navigation) {
    border-bottom: 1px solid #e6e6e6;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(10px);
  }
  :global(.nav-logo a) {
    color: #e2231a;
    letter-spacing: 0.5px;
  }
  :global(.nav-link) {
    font-weight: 500;
    color: #1a1a1a;
  }
  :global(.nav-link.active),
  :global(.nav-link:hover) {
    background: #e2231a;
    color: #ffffff;
  }

  /* Footer restyle -> dark Motherson footer */
  :global(.footer) {
    background: #1a1a1a !important;
    color: #f2f2f2 !important;
    border-top: 4px solid #e2231a !important;
    margin-top: 0;
  }
  :global(.footer h4),
  :global(.footer p),
  :global(.footer .text-small) {
    color: #f2f2f2 !important;
  }
  :global(.footer a) { color: #d6d6d6 !important; }
  :global(.footer a:hover) { color: #ffffff !important; }
  :global(.footer .footer-bottom) { border-top: 1px solid #3a3a3a !important; }
  :global(.footer .temp-page-nav) { color: rgba(255, 255, 255, 0.78) !important; }

  /* ===== Shared bits ===== */
  .mi-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin-bottom: 16px;
  }
  .mi-eyebrow-red { color: #e2231a; }

  .mi-section { padding: 88px 0; }
  .mi-light { background: #f6f6f4; }

  .mi-section-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 760px;
    margin-bottom: 48px;
  }

  .mi-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 12px 26px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }
  .mi-btn-red { background: #e2231a; color: #fff; }
  .mi-btn-red:hover { background: #b81b14; color: #fff; }
  .mi-btn-ghost { background: transparent; border-color: #1a1a1a; color: #1a1a1a; }
  .mi-btn-ghost:hover { background: #1a1a1a; color: #fff; }

  /* ===== Announcement band ===== */
  .mi-announce {
    background: #e2231a;
    color: #fff;
  }
  .mi-announce-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .mi-announce a { color: #fff; }
  .mi-announce a:hover { text-decoration: underline; }

  /* ===== Hero ===== */
  .mi-hero {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }
  .mi-hero-media {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 70%, rgba(0,0,0,0.78) 100%),
      linear-gradient(135deg, #2b2b2b 0%, #555 55%, #1a1a1a 100%),
      repeating-linear-gradient(120deg, rgba(255,255,255,0.04) 0 2px, transparent 2px 26px);
  }
  .mi-hero-media::after {
    content: "";
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 8px;
    background: #e2231a;
  }
  .mi-hero-inner {
    position: relative;
    padding: 64px 0 56px;
  }
  .mi-hero .mi-eyebrow { color: #ffb3af; }
  .mi-hero h1 {
    font-size: clamp(36px, 6vw, 68px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 880px;
    margin-bottom: 22px;
    color: #fff;
  }
  .mi-hero-sub {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.5;
    color: #e9e9e9;
  }

  /* ===== Intro ===== */
  .mi-intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }
  .mi-intro h2 {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .mi-intro-body p {
    color: #4a4a4a;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 18px;
  }

  /* ===== Cards ===== */
  .mi-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .mi-card {
    background: #fff;
    border: 1px solid #e6e6e6;
    padding: 36px 30px;
    display: flex;
    flex-direction: column;
    min-height: 240px;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .mi-card:hover {
    box-shadow: 0 18px 40px rgba(0,0,0,0.08);
    transform: translateY(-3px);
  }
  .mi-card h3 {
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 14px;
  }
  .mi-card p { color: #555; line-height: 1.55; flex: 1; }
  .mi-card-link {
    color: #e2231a;
    font-weight: 600;
    font-size: 14px;
    margin-top: 18px;
  }

  /* ===== Industries / Products thumbnails ===== */
  .mi-industries {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .mi-products {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .mi-industry h4, .mi-product h4 {
    font-size: 17px;
    font-weight: 500;
    margin-top: 14px;
  }
  .mi-thumb {
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(135deg, rgba(226,35,26,0.14), transparent 42%),
      repeating-linear-gradient(0deg, #dcdcd6 0 12px, #efefea 12px 24px);
  }

  /* ===== Feature (custom solutions) ===== */
  .mi-feature { background: #1a1a1a; color: #fff; }
  .mi-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }
  .mi-feature-media {
    min-height: 480px;
    background:
      linear-gradient(140deg, rgba(226,35,26,0.85), rgba(226,35,26,0.1) 34%, transparent 34%),
      linear-gradient(135deg, #3a3a3a 0%, #6a6a6a 60%, #2a2a2a 100%);
  }
  .mi-feature-copy { padding: 80px 0 80px 64px; }
  .mi-feature-copy h2 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 300;
    line-height: 1.12;
    margin-bottom: 20px;
    color: #fff;
  }
  .mi-feature-copy p { color: #cfcfcf; line-height: 1.6; margin-bottom: 22px; }
  .mi-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  .mi-feature-list li {
    padding: 12px 0;
    border-top: 1px solid #3a3a3a;
    font-weight: 500;
  }

  /* ===== Why grid ===== */
  .mi-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #e6e6e6;
    border: 1px solid #e6e6e6;
  }
  .mi-why {
    background: #fff;
    padding: 36px 30px;
  }
  .mi-why h4 {
    font-size: 19px;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .mi-why h4::before {
    content: "";
    display: block;
    width: 32px;
    height: 3px;
    background: #e2231a;
    margin-bottom: 16px;
  }
  .mi-why p { color: #555; line-height: 1.55; }

  /* ===== Strip ===== */
  .mi-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    border: 1px solid #e6e6e6;
    padding: 32px 40px;
  }
  .mi-strip strong { display: block; font-size: 20px; font-weight: 500; }
  .mi-strip span { color: #777; }
  .mi-strip-link {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    border: 1px solid #e2231a;
    color: #e2231a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    transition: all 0.2s ease;
  }
  .mi-strip-link:hover { background: #e2231a; color: #fff; }

  /* ===== Final CTA ===== */
  .mi-cta {
    background: #f6f6f4;
    border-top: 4px solid #e2231a;
    padding: 88px 0;
  }
  .mi-cta-inner { max-width: 720px; }
  .mi-cta-inner h2 {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 18px;
  }
  .mi-cta-inner p { color: #4a4a4a; font-size: 17px; line-height: 1.6; margin-bottom: 32px; }
  .mi-cta-actions { display: flex; gap: 16px; flex-wrap: wrap; }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .mi-intro-grid,
    .mi-card-grid,
    .mi-industries,
    .mi-feature-grid,
    .mi-why-grid {
      grid-template-columns: 1fr 1fr;
    }
    .mi-products { grid-template-columns: repeat(3, 1fr); }
    .mi-feature-copy { padding: 56px 0; }
    .mi-feature-media { min-height: 320px; }
  }

  @media (max-width: 640px) {
    .mi-section { padding: 56px 0; }
    .mi-announce-inner { flex-direction: column; gap: 6px; text-align: center; }
    .mi-card-grid,
    .mi-industries,
    .mi-products,
    .mi-why-grid,
    .mi-intro-grid {
      grid-template-columns: 1fr;
    }
    .mi-strip { flex-direction: column; gap: 20px; text-align: center; }
    .mi-cta-actions { flex-direction: column; }
  }
</style>
