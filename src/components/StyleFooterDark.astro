---
import TemporaryPageNav from './TemporaryPageNav.astro';

const currentYear = new Date().getFullYear();
---

<footer class="sfooter">
  <div class="container">
    <div class="sfooter-content">
      <div class="sfooter-section">
        <h4>Merc Technologies</h4>
        <p>Precision Gauge Manufacturing</p>
        <p class="sfooter-small">Since 2003</p>
      </div>

      <div class="sfooter-section">
        <h4>Contact</h4>
        <p>Email: merctech03@yahoo.co.in</p>
        <p>Phone: +91 9845765081</p>
        <p>Phone: +91 9845538144</p>
      </div>

      <div class="sfooter-section">
        <h4>Quick Links</h4>
        <ul class="sfooter-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/products">Products</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="sfooter-bottom">
      <TemporaryPageNav tone="dark" />
      <p class="sfooter-small">© {currentYear} Merc Technologies. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .sfooter {
    background-color: #0e0f12;
    color: #f7f7f4;
    padding: var(--space-2xl) 0 var(--space-lg) 0;
  }

  .sfooter-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .sfooter-section h4 {
    color: #f7f7f4;
    margin-bottom: var(--space-sm);
  }

  .sfooter-section p {
    color: #c9c9c3;
    margin-bottom: var(--space-xs);
  }

  .sfooter-small {
    opacity: 0.7;
  }

  .sfooter-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sfooter-links li {
    margin-bottom: var(--space-xs);
  }

  .sfooter-links a {
    color: #f7f7f4;
    text-decoration: underline;
  }

  .sfooter-links a:hover {
    font-weight: 600;
  }

  .sfooter-bottom {
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    text-align: center;
  }

  @media (max-width: 640px) {
    .sfooter-content {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
