---
import {
  getContent,
  getLocalePath,
  localeLabels,
  locales,
  type Locale,
  type PageKey,
} from '../i18n';

interface Props {
  locale?: Locale;
  pageKey?: PageKey;
}

const { locale = 'en', pageKey = 'home' } = Astro.props;
const currentYear = new Date().getFullYear();
const t = getContent(locale);

const quickLinks = [
  ['home', t.nav.home],
  ['about', t.nav.about],
  ['products', t.nav.products],
  ['careers', t.nav.careers],
  ['contact', t.nav.contact],
] as [PageKey, string][];
---

<footer class="sfooter">
  <div class="container">
    <div class="sfooter-content">
      <div class="sfooter-section">
        <h4>Merc Technologies</h4>
        <p>{t.footer.tagline}</p>
        <p class="sfooter-small">{t.footer.since}</p>
      </div>

      <div class="sfooter-section">
        <h4>{t.footer.contact}</h4>
        <p>Email: merctech03@yahoo.co.in</p>
        <p>Phone: +91 9845765081</p>
        <p>Phone: +91 9845538144</p>
      </div>

      <div class="sfooter-section">
        <h4>{t.footer.quickLinks}</h4>
        <ul class="sfooter-links">
          {quickLinks.map(([page, label]) => (
            <li><a href={getLocalePath(locale, page)}>{label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="sfooter-bottom">
      <div class="sfooter-languages" aria-label={t.language}>
        {locales.map((lang) => (
          <a class:list={{ active: lang === locale }} href={getLocalePath(lang, pageKey)}>
            {localeLabels[lang]}
          </a>
        ))}
      </div>
      <p class="sfooter-small">© {currentYear} Merc Technologies. {t.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .sfooter {
    background-color: #0e0f12;
    color: #f7f7f4;
    padding: var(--space-2xl) 0 var(--space-lg) 0;
  }

  .sfooter-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .sfooter-section h4 {
    color: #f7f7f4;
    margin-bottom: var(--space-sm);
  }

  .sfooter-section p {
    color: #c9c9c3;
    margin-bottom: var(--space-xs);
  }

  .sfooter-small {
    opacity: 0.7;
  }

  .sfooter-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sfooter-links li {
    margin-bottom: var(--space-xs);
  }

  .sfooter-links a {
    color: #f7f7f4;
    text-decoration: underline;
  }

  .sfooter-links a:hover {
    font-weight: 600;
  }

  .sfooter-bottom {
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    text-align: center;
  }

  .sfooter-languages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 16px;
    margin-bottom: var(--space-md);
  }

  .sfooter-languages a {
    color: #f7f7f4;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    opacity: 0.78;
  }

  .sfooter-languages a.active {
    opacity: 1;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .sfooter-content {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
