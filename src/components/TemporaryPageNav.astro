---
interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;

const pageLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/products', label: 'Products' },
  { href: '/contact', label: 'Contact' },
  { href: '/style1', label: 'Style 1' },
  { href: '/style3', label: 'Style 3' },
  { href: '/boeing-inspired-homepage', label: 'Boeing Inspired Homepage' },
  { href: '/motherson-inspired-homepage', label: 'Motherson Inspired Homepage' },
];
---

<nav class:list={['temp-page-nav', `temp-page-nav--${tone}`]} aria-label="Temporary page navigation">
  <span class="temp-page-nav__label">Temporary page links</span>
  <ul>
    {pageLinks.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .temp-page-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid currentColor;
  }

  .temp-page-nav--light {
    color: rgba(0, 0, 0, 0.68);
  }

  .temp-page-nav--dark {
    color: rgba(255, 255, 255, 0.72);
  }

  .temp-page-nav__label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .temp-page-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.9rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .temp-page-nav li {
    margin: 0;
  }

  .temp-page-nav a {
    color: inherit;
    font-size: 0.88rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .temp-page-nav a:hover {
    color: currentColor;
    font-weight: 700;
  }
</style>
