---
import StyleDarkLayout from '../layouts/StyleDarkLayout.astro';
import { getContent, getLocalePath, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
const home = t.home;
---

<StyleDarkLayout title={home.title} description={home.description} locale={locale} pageKey="home">
  <section class="s3-hero">
    <div class="s3-hero-media" aria-hidden="true"></div>
    <div class="s3-hero-overlay" aria-hidden="true"></div>
    <div class="container s3-hero-copy">
      <h1>{home.heroTitle}</h1>
      <p class="s3-hero-sub">{home.heroText}</p>
      <div class="s3-hero-actions">
        <a class="s3-btn s3-btn-primary" href={getLocalePath(locale, 'products')}>{t.common.viewProducts}</a>
        <a class="s3-btn" href={getLocalePath(locale, 'contact')}>{t.common.requestQuote}</a>
      </div>
    </div>
    <p class="s3-hero-footnote">{home.footnote}</p>
  </section>

  <section class="s3-feature-row">
    <div class="container">
      <h2 class="s3-section-title">{home.sections.what}</h2>
      <div class="s3-feature-grid">
        {home.services.map(([title, description], index) => (
          <a class="s3-feature-card" href={index === 1 ? getLocalePath(locale, 'contact') : getLocalePath(locale, 'products')}>
            <div class:list={['s3-feature-img', `s3-fimg-${(index % 3) + 1}`]} aria-hidden="true"></div>
            <div class="s3-feature-bar">
              <div>
                <strong>{title}</strong>
                <p>{description}</p>
              </div>
              <i>→</i>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="s3-models">
    <div class="container">
      <h2 class="s3-section-title">{home.sections.products}</h2>
      <div class="s3-model-grid">
        {home.products.map((name, index) => (
          <article class="s3-model-card">
            <div class="s3-model-body">
              <div class="s3-model-name">{name}</div>
              <div class:list={['s3-model-shape', `s3-shape-${index + 1}`]} aria-hidden="true"></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="s3-industries">
    <div class="container">
      <h2 class="s3-section-title">{home.sections.industries}</h2>
      <div class="s3-industry-grid">
        {home.industries.map((industry, index) => (
          <a class="s3-industry-card" href={getLocalePath(locale, 'about')}>
            <div class:list={['s3-industry-img', `s3-iimg-${(index % 3) + 1}`]} aria-hidden="true"></div>
            <span class="s3-industry-label">{industry}<i>→</i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="s3-custom">
    <div class="container s3-custom-grid">
      <div class="s3-custom-media" aria-hidden="true"></div>
      <div class="s3-custom-text">
        <h2>{home.sections.custom}</h2>
        <p>{home.customText}</p>
        <ul class="s3-custom-list">
          {home.customList.map((item) => <li>{item}</li>)}
        </ul>
        <a class="s3-btn s3-btn-primary" href={getLocalePath(locale, 'contact')}>{home.discuss}</a>
      </div>
    </div>
  </section>

  <section class="s3-specs">
    <div class="container">
      <h2 class="s3-section-title">{home.sections.why}</h2>
      <div class="s3-spec-grid">
        {home.why.map(([title, description], index) => (
          <div>
            <strong>{String(index + 1).padStart(2, '0')}</strong>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="s3-cta">
    <div class="container s3-cta-content">
      <h2>{home.sections.cta}</h2>
      <p>{home.ctaText}</p>
      <div class="s3-hero-actions">
        <a class="s3-btn s3-btn-primary" href={getLocalePath(locale, 'contact')}>{t.common.requestQuote}</a>
        <a class="s3-btn" href={getLocalePath(locale, 'products')}>{t.common.browseProducts}</a>
      </div>
    </div>
  </section>
</StyleDarkLayout>

<style>
  :global(body) {
    background: #fff;
    color: #0e0f12;
  }

  .s3-btn {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 11px 24px;
    border: 1px solid currentColor;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .s3-btn-primary {
    background: #d5001c;
    border-color: #d5001c;
    color: #fff;
  }

  .s3-btn-primary:hover {
    background: #b00018;
  }

  .s3-hero {
    position: relative;
    min-height: clamp(440px, 58vw, 640px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }

  .s3-hero-media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 70% 20%, rgba(120,130,140,0.55), transparent 55%),
      linear-gradient(115deg, #3a4048 0%, #1d2025 45%, #0a0b0d 100%);
  }

  .s3-hero-media::after {
    content: "";
    position: absolute;
    right: 6%;
    top: 32%;
    width: min(58vw, 760px);
    height: 150px;
    border-radius: 999px;
    background: linear-gradient(90deg, #eef0ef, #9aa0a4 46%, #20242a);
    transform: rotate(-7deg);
    box-shadow: 0 50px 90px rgba(0,0,0,0.45);
  }

  .s3-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8,9,11,0.82) 0%, rgba(8,9,11,0.4) 48%, transparent 80%);
  }

  .s3-hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .s3-hero h1 {
    color: #fff;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.04;
    margin-bottom: 20px;
    max-width: 640px;
  }

  .s3-hero-sub {
    color: #e4e4dd;
    max-width: 520px;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .s3-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .s3-hero-footnote {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    z-index: 1;
    text-align: center;
    color: rgba(255,255,255,0.66);
    font-size: 12px;
    padding: 0 60px;
  }

  .s3-feature-row,
  .s3-models {
    background: #fff;
    padding: 60px 0;
  }

  .s3-section-title {
    font-size: clamp(28px, 3.6vw, 42px);
    margin-bottom: 36px;
  }

  .s3-feature-grid,
  .s3-industry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .s3-feature-card {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    background: #111216;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .s3-feature-img {
    height: 170px;
  }

  .s3-fimg-1 { background: linear-gradient(135deg, #6f7479, #14161a); }
  .s3-fimg-2 { background: linear-gradient(135deg, #8aa0c4, #1c2733); }
  .s3-fimg-3 { background: linear-gradient(135deg, #d5001c, #2a0e12); }

  .s3-feature-bar {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px 22px;
    color: #fff;
  }

  .s3-feature-bar strong {
    display: block;
    font-size: 17px;
    margin-bottom: 6px;
  }

  .s3-feature-bar p {
    color: #b9bbc0;
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }

  .s3-feature-bar i,
  .s3-industry-label i {
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-style: normal;
  }

  .s3-feature-bar i {
    width: 30px;
    height: 30px;
    font-size: 13px;
  }

  .s3-model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px;
  }

  .s3-model-body {
    position: relative;
    background: #0e0f12;
    border-radius: 8px;
    min-height: 280px;
    padding: 26px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .s3-model-name {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    text-align: center;
    color: #fff;
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 800;
  }

  .s3-model-shape {
    width: 66%;
    height: 110px;
    border-radius: 999px;
    background: linear-gradient(90deg, #f0f0eb, #9da1a4, #25282d);
    box-shadow: 0 22px 50px rgba(0,0,0,0.5);
  }

  .s3-shape-2 { border-radius: 30px; background: repeating-linear-gradient(90deg, #1c1f25 0 16px, #b9bdc0 16px 28px); }
  .s3-shape-3 { border-radius: 14px 80px 14px 80px; background: linear-gradient(135deg, #cfd1d2, #6b6f73 50%, #15171c); }
  .s3-shape-4 { border-radius: 50%; width: 150px; height: 150px; background: radial-gradient(circle at 50% 50%, #0e0f12 30%, #b9bdc0 31%, #e9e9e4 70%, #6b6f73 100%); }
  .s3-shape-5 { border-radius: 80px 14px 80px 14px; background: linear-gradient(135deg, #d5001c, #d7d7d2 48%, #15171c); }

  .s3-industries {
    background: #f7f7f4;
    padding: 70px 0 80px;
  }

  .s3-industry-card {
    position: relative;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    min-height: 220px;
    text-decoration: none;
  }

  .s3-industry-img {
    position: absolute;
    inset: 0;
  }

  .s3-iimg-1 { background: linear-gradient(135deg, #4d5056, #14161a); }
  .s3-iimg-2 { background: linear-gradient(135deg, #7d828a, #20242b); }
  .s3-iimg-3 { background: linear-gradient(135deg, #b6453f, #2a1416); }

  .s3-industry-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(0,0,0,0.72));
  }

  .s3-industry-label {
    position: absolute;
    z-index: 1;
    left: 20px;
    right: 20px;
    bottom: 18px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }

  .s3-industry-label i {
    width: 26px;
    height: 26px;
    font-size: 12px;
  }

  .s3-custom {
    background: #15171c;
  }

  .s3-custom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }

  .s3-custom-media {
    min-height: 480px;
    background:
      linear-gradient(180deg, transparent 10%, rgba(0,0,0,0.7)),
      radial-gradient(circle at 60% 40%, rgba(213,0,28,0.4), transparent 30%),
      linear-gradient(135deg, #4d5056, #14161a);
  }

  .s3-custom-text {
    padding: 70px clamp(20px, 4vw, 56px);
    color: #f7f7f4;
    align-self: center;
  }

  .s3-custom-text h2,
  .s3-specs .s3-section-title,
  .s3-spec-grid h3,
  .s3-cta-content h2 {
    color: #fff;
  }

  .s3-custom-text p,
  .s3-spec-grid p,
  .s3-cta-content p {
    color: #c9c9c3;
  }

  .s3-custom-list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: grid;
    gap: 12px;
  }

  .s3-custom-list li {
    border-top: 1px solid rgba(255,255,255,0.16);
    padding-top: 12px;
    font-weight: 600;
  }

  .s3-specs {
    background: #0e0f12;
    color: #f7f7f4;
    padding: 80px 0;
  }

  .s3-spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .s3-spec-grid > div {
    border-top: 1px solid rgba(255,255,255,0.18);
    padding-top: 22px;
  }

  .s3-spec-grid strong {
    color: #d5001c;
    display: block;
    margin-bottom: 14px;
    font-size: 15px;
  }

  .s3-cta {
    background: #15171c;
    color: #fff;
    padding: 90px 0;
  }

  .s3-cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .s3-cta-content .s3-hero-actions {
    justify-content: center;
  }

  .s3-cta .s3-btn:not(.s3-btn-primary) {
    color: #fff;
  }

  @media (max-width: 960px) {
    .s3-feature-grid,
    .s3-industry-grid,
    .s3-spec-grid {
      grid-template-columns: 1fr 1fr;
    }

    .s3-custom-grid {
      grid-template-columns: 1fr;
    }

    .s3-custom-media {
      min-height: 280px;
    }
  }

  @media (max-width: 640px) {
    .s3-feature-grid,
    .s3-model-grid,
    .s3-industry-grid,
    .s3-spec-grid {
      grid-template-columns: 1fr;
    }

    .s3-hero-footnote {
      display: none;
    }

    .s3-hero-actions {
      flex-direction: column;
    }
  }
</style>
