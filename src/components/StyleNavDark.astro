---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];
---

<nav class="snav">
  <div class="container">
    <div class="snav-content">
      <div class="snav-logo">
        <a href="/">MERC TECHNOLOGIES</a>
      </div>

      <button class="snav-hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span class="snav-hamburger-line"></span>
        <span class="snav-hamburger-line"></span>
        <span class="snav-hamburger-line"></span>
      </button>

      <ul class="snav-links">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['snav-link', { active: currentPath === item.href }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.querySelector('.snav-hamburger');
  const navLinks = document.querySelector('.snav-links');

  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      const isExpanded = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', (!isExpanded).toString());
      hamburger.classList.toggle('active');
      navLinks.classList.toggle('active');
    });

    const links = navLinks.querySelectorAll('.snav-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('active');
        navLinks.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  .snav {
    background-color: rgba(14, 15, 18, 0.92);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .snav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 0;
    position: relative;
  }

  .snav-logo a {
    color: #f7f7f4;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
  }

  .snav-hamburger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: 1px solid #f7f7f4;
    padding: 10px;
    cursor: pointer;
    z-index: 101;
  }

  .snav-hamburger-line {
    display: block;
    width: 25px;
    height: 2px;
    background-color: #f7f7f4;
    transition: all 0.3s ease;
  }

  .snav-hamburger.active .snav-hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .snav-hamburger.active .snav-hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .snav-hamburger.active .snav-hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .snav-links {
    display: flex;
    list-style: none;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }

  .snav-link {
    color: #f7f7f4;
    padding: 8px 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .snav-link:hover,
  .snav-link.active {
    background-color: #f7f7f4;
    color: #0e0f12;
  }

  @media (max-width: 768px) {
    .snav-hamburger {
      display: flex;
    }

    .snav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background-color: #0e0f12;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
      pointer-events: none;
    }

    .snav-links.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .snav-links li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .snav-links li:last-child {
      border-bottom: none;
    }

    .snav-link {
      display: block;
      width: 100%;
      padding: var(--space-md) var(--space-md);
    }
  }
</style>
