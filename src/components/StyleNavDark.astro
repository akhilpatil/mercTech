---
import {
  getContent,
  getLocalePath,
  localeLabels,
  locales,
  type Locale,
  type PageKey,
} from '../i18n';

interface Props {
  locale?: Locale;
  pageKey?: PageKey;
}

const { locale = 'en', pageKey = 'home' } = Astro.props;
const t = getContent(locale);

const navItems = [
  { page: 'home', label: t.nav.home },
  { page: 'products', label: t.nav.products },
  { page: 'about', label: t.nav.about },
  { page: 'careers', label: t.nav.careers },
  { page: 'contact', label: t.nav.contact },
] satisfies { page: PageKey; label: string }[];
---

<nav class="snav">
  <div class="container">
    <div class="snav-content">
      <div class="snav-logo">
        <a href={getLocalePath(locale)}>MERC TECHNOLOGIES</a>
      </div>

      <button class="snav-hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span class="snav-hamburger-line"></span>
        <span class="snav-hamburger-line"></span>
        <span class="snav-hamburger-line"></span>
      </button>

      <ul class="snav-links">
        {navItems.map(item => (
          <li>
            <a
              href={getLocalePath(locale, item.page)}
              class:list={['snav-link', { active: pageKey === item.page }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="snav-language">
        <label for="language-select">{t.language}</label>
        <select id="language-select" aria-label={t.language}>
          {locales.map((lang) => (
            <option value={getLocalePath(lang, pageKey)} selected={lang === locale}>
              {localeLabels[lang]}
            </option>
          ))}
        </select>
      </div>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.querySelector('.snav-hamburger');
  const navLinks = document.querySelector('.snav-links');

  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      const isExpanded = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', (!isExpanded).toString());
      hamburger.classList.toggle('active');
      navLinks.classList.toggle('active');
    });

    const links = navLinks.querySelectorAll('.snav-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('active');
        navLinks.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  const languageSelect = document.querySelector('#language-select');

  if (languageSelect instanceof HTMLSelectElement) {
    languageSelect.addEventListener('change', () => {
      window.location.href = languageSelect.value;
    });
  }
</script>

<style>
  .snav {
    background-color: rgba(14, 15, 18, 0.92);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .snav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    position: relative;
  }

  .snav-logo a {
    color: #f7f7f4;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
  }

  .snav-hamburger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: 1px solid #f7f7f4;
    padding: 10px;
    cursor: pointer;
    z-index: 101;
  }

  .snav-hamburger-line {
    display: block;
    width: 25px;
    height: 2px;
    background-color: #f7f7f4;
    transition: all 0.3s ease;
  }

  .snav-hamburger.active .snav-hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .snav-hamburger.active .snav-hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .snav-hamburger.active .snav-hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .snav-links {
    display: flex;
    list-style: none;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }

  .snav-language {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f7f7f4;
    margin-left: auto;
  }

  .snav-language label {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
  }

  .snav-language select {
    width: auto;
    min-width: 120px;
    border: 1px solid rgba(255,255,255,0.55);
    background: #15171c;
    color: #f7f7f4;
    padding: 8px 28px 8px 10px;
    font-size: 13px;
  }

  .snav-link {
    color: #f7f7f4;
    padding: 8px 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .snav-link:hover,
  .snav-link.active {
    background-color: #f7f7f4;
    color: #0e0f12;
  }

  @media (max-width: 768px) {
    .snav-content {
      flex-wrap: wrap;
    }

    .snav-hamburger {
      display: flex;
      order: 3;
    }

    .snav-language {
      order: 2;
      margin-left: 0;
    }

    .snav-links {
      order: 4;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background-color: #0e0f12;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
      pointer-events: none;
    }

    .snav-links.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .snav-links li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .snav-links li:last-child {
      border-bottom: none;
    }

    .snav-link {
      display: block;
      width: 100%;
      padding: var(--space-md) var(--space-md);
    }
  }

  @media (max-width: 520px) {
    .snav-logo a {
      font-size: 16px;
    }

    .snav-language label {
      display: none;
    }

    .snav-language select {
      min-width: 104px;
    }
  }
</style>
