---
import Button from './Button.astro';
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 data-heading-cycle>Precision You Can Trust</h1>
      <p class="hero-subtitle" data-subtitle-cycle>
        ISO-certified gauge solutions engineered for automotive, aerospace, and manufacturing industries.
        Custom and standard gauges built to exacting specifications.
      </p>
      <div class="hero-ctas">
        <Button href="/products" large>View Products</Button>
        <Button href="/contact" large>Request Quote</Button>
      </div>
    </div>

    <div class="hero-image">
      <div class="image-placeholder image-placeholder-16-9"></div>
    </div>

    <div class="trust-strip">
      <div class="trust-item">ISO 9001:2015 Certified</div>
      <div class="trust-item">20+ Years Experience</div>
      <div class="trust-item">Micron-Level Precision</div>
      <div class="trust-item">Custom Solutions</div>
    </div>
  </div>
</section>

<script>
  const headingOptions = [
    'Precision You Can Trust',
    'Custom Gauges Built for Mission-Critical Measurements',
    'Exacting Gauge Solutions for Demanding Production Lines',
    'High-Precision Gauges Engineered for Reliable Inspection',
    'Measurement Tools Built to Hold the Tightest Tolerances',
  ];
  const subtitleOptions = [
    'ISO-certified gauge solutions engineered for automotive, aerospace, and manufacturing industries. Custom and standard gauges built to exacting specifications.',
    'From plug and ring gauges to custom inspection fixtures, we build measurement tools that keep production quality on target.',
    'Precision-built gauges, calibration support, and custom solutions for teams that cannot afford inspection uncertainty.',
    'Engineered for repeatable measurement, long service life, and dependable performance across high-demand manufacturing environments.',
    'Standard and custom gauge manufacturing backed by tight process control, practical engineering support, and fast quoting.',
  ];

  const cyclingHeading = document.querySelector('[data-heading-cycle]');
  const cyclingSubtitle = document.querySelector('[data-subtitle-cycle]');

  if (cyclingHeading) {
    let headingIndex = 0;

    cyclingHeading.addEventListener('click', () => {
      headingIndex = (headingIndex + 1) % headingOptions.length;
      cyclingHeading.textContent = headingOptions[headingIndex];
    });
  }

  if (cyclingSubtitle) {
    let subtitleIndex = 0;

    cyclingSubtitle.addEventListener('click', () => {
      subtitleIndex = (subtitleIndex + 1) % subtitleOptions.length;
      cyclingSubtitle.textContent = subtitleOptions[subtitleIndex];
    });
  }
</script>

<style>
  .hero {
    padding: var(--space-2xl) 0;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .hero-subtitle {
    font-size: 18px;
    margin-bottom: var(--space-xl);
    line-height: 1.8;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-image {
    max-width: 900px;
    margin: var(--space-2xl) auto;
  }

  .trust-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: var(--border-thin);
  }

  .trust-item {
    text-align: center;
    font-weight: 600;
    padding: var(--space-md);
    border: var(--border-thin);
  }

  @media (max-width: 640px) {
    .hero-ctas {
      flex-direction: column;
    }

    .trust-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
