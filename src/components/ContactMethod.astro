---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<div class="contact-method">
  <h3>{title}</h3>
  <p>{body}</p>
</div>

<style>
  .contact-method {
    border-top: 1px solid rgba(14,15,18,0.16);
    padding-top: 18px;
    margin-top: 18px;
  }

  .contact-method h3 {
    margin-bottom: 6px;
  }

  .contact-method p {
    white-space: pre-line;
    font-weight: 700;
    color: #0e0f12;
  }
</style>
